<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.mertnotch"
          path="/org/gnome/shell/extensions/mertnotch/">

    <key name="show-system" type="b">
      <default>true</default>
      <summary>Show system monitor in expanded view</summary>
    </key>

    <key name="show-dropshelf" type="b">
      <default>true</default>
      <summary>Enable file drop shelf</summary>
    </key>

    <key name="show-notifications" type="b">
      <default>true</default>
      <summary>Enable dynamic notification peek</summary>
    </key>

    <key name="show-calendar" type="b">
      <default>true</default>
      <summary>Enable Google Calendar peek</summary>
    </key>

    <key name="show-tasks" type="b">
      <default>true</default>
      <summary>Enable Google Tasks peek</summary>
    </key>

    <key name="poll-interval" type="i">
      <default>3</default>
      <range min="1" max="30"/>
      <summary>System monitor poll interval (seconds)</summary>
    </key>

    <key name="collapsed-width" type="i">
      <default>160</default>
      <range min="120" max="360"/>
      <summary>Collapsed notch width in pixels</summary>
    </key>

    <key name="expanded-width" type="i">
      <default>560</default>
      <range min="400" max="900"/>
      <summary>Expanded notch width in pixels</summary>
    </key>

    <key name="notif-auto-dismiss" type="i">
      <default>8</default>
      <range min="0" max="120"/>
      <summary>Auto-dismiss banner notifications after N seconds (0 = disabled)</summary>
    </key>

    <key name="dropshelf-destination" type="s">
      <choices>
        <choice value="local"/>
        <choice value="drive"/>
        <choice value="local+drive"/>
      </choices>
      <default>"local"</default>
      <summary>Where dropped files go</summary>
    </key>

    <key name="dropshelf-account" type="s">
      <default>""</default>
      <summary>GOA Google account email for Drive uploads</summary>
    </key>

    <key name="dropshelf-drive-folder" type="s">
      <default>"root"</default>
      <summary>Drive folder ID to upload into (root = My Drive)</summary>
    </key>
  </schema>
</schemalist>
